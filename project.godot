; Engine configuration file.
; 어원 RPG — Godot 4.7.2-stable 기준(docs/design/04-meta.md 1절)

config_version=5

[application]

config/name="어원 RPG"
config/description="어원 단어장 데이터로 만드는 수집형 RPG"
run/main_scene="res://src/ui/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/events/event_bus.gd"
GameData="*res://src/flow/game_data.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/Jua-Regular.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=false

[internationalization]

locale/translations=PackedStringArray("res://locale/names.ko.translation", "res://locale/ui.ko.translation", "res://locale/system.ko.translation", "res://locale/story.ko.translation")
locale/fallback="ko"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
